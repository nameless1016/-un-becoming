[sub_resource type="Resource" id="Resource_k36fh"]
resource_name = "Fake_Friends.txt [entry_fake_friends]"
script = ExtResource("1_p77w3")
file_id = "entry_fake_friends"
filename = "Fake_Friends.txt"
description = "Personal log written after the haunted house prank.
"
content = "They smiled all week, then locked the door from the outside. I sat on the cold floor for an hour listening to them laugh down the corridor. Nobody was joking. They just wanted me gone."
ghost_hint_solved = "I remember the lock turning from the outside. That was the last day I went to school."
can_interpret = true
metadata/_custom_type_script = "uid://buxyckyv4tgap"

[sub_resource type="Resource" id="Resource_g2rd1"]
resource_name = "Cults.txt [entry_cults]"
script = ExtResource("1_p77w3")
file_id = "entry_cults"
filename = "Cults.txt"
description = "Web search notes and forum definitions.
"
content = "People call online groups cults when they don't understand them. Society labels anything outside the norm as dangerous. But if the world outside offers only cruelty, why is seeking shelter called radical?"
ghost_hint_solved = "This was where I began defending them to myself."
can_interpret = true
metadata/_custom_type_script = "uid://buxyckyv4tgap"

[sub_resource type="Resource" id="Resource_jlq73"]
resource_name = "Nothing_Is_Real.txt [entry_nothing_is_real]"
script = ExtResource("1_p77w3")
file_id = "entry_nothing_is_real"
filename = "Nothing_Is_Real.txt"
description = "Personal log during bedroom isolation."
content = "People on the street speak like prerecorded tapes. Smiles are performance. The only place where words carry genuine weight is the private board. The Order is the only family that stays.
"
ghost_hint_solved = "The curtains stayed closed for three months after I wrote this."
can_interpret = true
metadata/_custom_type_script = "uid://buxyckyv4tgap"

[sub_resource type="Resource" id="Resource_6lbq8"]
resource_name = "Anarchy.txt [entry_anarchy]"
script = ExtResource("1_p77w3")
file_id = "entry_anarchy"
filename = "Anarchy.txt"
description = "Reflections on ideological literature provided by The Order."
content = "You cannot renovate a foundation made of mold. You clear the ground with flame so something genuine can grow. If the snakes scream while the house burns, they are only proving the sickness was real."
ghost_hint_solved = "Their phrases had completely replaced my own thoughts."
can_interpret = true
metadata/_custom_type_script = "uid://buxyckyv4tgap"

